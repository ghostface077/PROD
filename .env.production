########################################
# IT SUPPORT — Variables d'environnement de PRODUCTION
# Copiez ce fichier en ".env.production" puis renseignez vos propres valeurs.
# Ne JAMAIS committer le fichier ".env.production" réel (déjà exclu par .gitignore).
#
# Rappel : app/config.py refuse de démarrer en production si SECRET_KEY est
# un secret de démo connu (ou < 32 caractères), ou si SEED_ON_STARTUP=true.
########################################

# --- Base de données PostgreSQL ---
# En local (docker-compose.prod.yml) : renseignez les 3 valeurs ci-dessous,
# DATABASE_URL les référence automatiquement.
# Avec Neon (Phase 5) : DATABASE_URL est fournie directement par Neon et
# remplace intégralement la ligne ci-dessous (POSTGRES_* ne servent plus).
POSTGRES_USER=itsupport
POSTGRES_PASSWORD=Admin1234
POSTGRES_DB=itsupport_db
DATABASE_URL=postgresql+psycopg2://itsupport:Admin1234@db:5432/itsupport_db

# --- Sécurité / JWT ---
# Générez une valeur aléatoire forte, par exemple :
#   openssl rand -hex 32
# Ne réutilisez JAMAIS la valeur de votre .env de développement.
SECRET_KEY=b39a3d2fa7d19ef9e863e49fc565dd57796d9aa8487f2cc23546e1f2606629bb
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Backend FastAPI ---
BACKEND_PORT=8000
# Domaine(s) exact(s) du frontend déployé, séparés par une virgule si plusieurs
# (ex. domaine de prévisualisation Vercel + domaine final). Sans "/" final.
# Cas auto-hébergé derrière le Nginx de ce dépôt (même origine pour le
# navigateur) : CORS ne s'applique jamais réellement dans ce flux, mais
# laissez tout de même l'IP/domaine réel du serveur ici (ex. http://votre-ip
# ou https://votre-domaine), jamais "*" — allow_credentials=True (requis pour
# les cookies) et allow_origins=["*"] sont incompatibles pour le navigateur.
BACKEND_CORS_ORIGINS=http://13.50.224.56:3000
ENVIRONMENT=production
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=15
ALLOW_CREDENTIALS=True
# --- Cookies d'authentification (voir _cookie_kwargs dans app/routers/auth.py) ---
# Par défaut (ces 2 lignes absentes), calqués sur ENVIRONMENT=production :
# Secure=true, SameSite=None — adapté au cas frontend (Vercel) et backend
# (Render) sur deux domaines HTTPS différents.

#
# Cas auto-hébergé derrière le Nginx de ce dépôt (docker-compose.prod.yml),
# TANT QU'AUCUN CERTIFICAT TLS N'EST ENCORE CONFIGURÉ (HTTP simple sur
# l'IP/le domaine du serveur) : décommentez ces 2 lignes. Sans elles, le
# navigateur rejette silencieusement le cookie "Secure" posé sur une connexion
# HTTP — la connexion semble réussir (200) mais l'utilisateur est aussitôt
# déconnecté (bug réel rencontré, voir le diagnostic associé).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
#
# Une fois un certificat TLS en place devant Nginx (Let's Encrypt/Certbot) :
# supprimez ces 2 lignes (retour au défaut ci-dessus) ou passez-les à
# COOKIE_SECURE=true / COOKIE_SAMESITE=lax (même origine : "lax" suffit,
# "none" ne sert qu'au cas Vercel/Render deux-domaines).

# Obligatoirement "false" en production — le backend refuse de toute façon de
# démarrer si ENVIRONMENT=production et que cette valeur reste à "true".
SEED_ON_STARTUP=false

# --- Frontend Next.js ---
FRONTEND_PORT=3000
# URL utilisée par le NAVIGATEUR pour appeler l'API (jamais "localhost" ni un
# nom de service Docker interne comme "backend", injoignables depuis le poste
# client). Att. : figée dans le bundle JS au moment du build (voir le
# commentaire dans frontend/Dockerfile) — toute modification de cette valeur
# nécessite un rebuild de l'image frontend (`--build`, pas seulement `up -d`).
#
# Cas auto-hébergé derrière le Nginx de ce dépôt (frontend et backend servis
# depuis la même origine, voir nginx/nginx.conf) : chemin RELATIF, le
# navigateur appelle alors /api/... sur sa propre origine, que Nginx route
# vers le backend :
NEXT_PUBLIC_API_URL=/api
# Cas frontend et backend sur deux domaines séparés (ex. Vercel + Render,
# pas de Nginx devant) : URL absolue du backend déployé, avec son propre
# suffixe /api :
# NEXT_PUBLIC_API_URL=https://REMPLACEZ_PAR_VOTRE_BACKEND.onrender.com/api

# --- Comptes de démonstration ---
# Volontairement ABSENTS de ce fichier : avec SEED_ON_STARTUP=false, ils ne
# servent à rien en production. Les comptes réels de démonstration pour la
# soutenance sont créés manuellement (voir Phase 9 / guide de démonstration),
# jamais via le seed automatique du code source.
